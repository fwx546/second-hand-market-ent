# 根目录本地开发格式参考，不含真实凭据；生产值由 Sites 私有环境配置保存。
# QQ 方案先运行 npm run mail:setup -- 你的QQ邮箱，自动生成两侧私有配置。
# QQ 授权码仅私下填写 relay/.env.local，不要放入此根目录配置。
# 不要添加 VITE_ / NEXT_PUBLIC_ 前缀，不要把密钥写入 public/ 或聊天。
JUZI_EMAIL_PROVIDER=qq_relay
JUZI_EMAIL_ENABLED=false

# 与 npm run dev -- --port 4174 一致；网页访问不要混用 127.0.0.1。
JUZI_EMAIL_ORIGIN=http://localhost:4174

# QQ 本地中继。令牌由准备脚本生成，与 relay 的 JUZI_RELAY_TOKEN 匹配。
# 生产不能使用 localhost 或 127.0.0.1，需部署 render.yaml 中的独立 HTTPS 中继。
# 生产 JUZI_EMAIL_ORIGIN 为公开 Sites Origin；RELAY_URL 为实际中继 URL + /send。
# 公网健康检查、鉴权及真实收件联测完成前，不启用生产 JUZI_EMAIL_ENABLED。
JUZI_EMAIL_RELAY_URL=http://127.0.0.1:4180/send
JUZI_EMAIL_RELAY_TOKEN=

# 准备脚本自动生成的高熵 HMAC 密钥，仅网站服务端使用。
JUZI_EMAIL_AUTH_SECRET=

# 本地 QQ 网站额度默认 50 次/滚动 24 小时，失败也计数，可调低。
# 中继另由 QQ_RELAY_DAILY_LIMIT 控制，重启不会重置持久账本。
JUZI_EMAIL_DAILY_LIMIT=50

# Resend 备选：显式将 provider 改为 resend 后使用以下两项。
# 发件域必须由维护者拥有并完成验证，不能冒充学校发件人。
JUZI_EMAIL_FROM=
RESEND_API_KEY=
