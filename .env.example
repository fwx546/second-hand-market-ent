# 复制为 .env.local 后填写；本文件可提交，真实配置文件不可提交。
# 先按 AUTH_SETUP.md 开通 Resend，并验证自己拥有的发件域名。
# 不要添加 VITE_ / NEXT_PUBLIC_ 前缀，不要把密钥写入 public/ 或聊天。
JUZI_EMAIL_ENABLED=false

# 精确站点 Origin，无末尾斜线。本地端口必须与 npm run dev 一致。
# 本地：http://localhost:5173 或 http://localhost:4174
# 生产：https://juzi-campus-market.open-bloom-6517.chatgpt.site
JUZI_EMAIL_ORIGIN=

# 使用维护者自有、已在 Resend 验证的域名；不能冒充学校发件人。
JUZI_EMAIL_FROM=
RESEND_API_KEY=

# 至少 32 字符的高熵密钥，用于验证码 HMAC；只保存在服务端。
JUZI_EMAIL_AUTH_SECRET=

# 可选整数 1..10000，留空使用默认 1000 次/滚动 24 小时。
# 发送失败也计入额度；首次开通建议按实际需求调低。
JUZI_EMAIL_DAILY_LIMIT=
