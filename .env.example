# 复制为 .env.local 后填写；本文件可提交，真实配置文件不可提交。
# 先按 AUTH_SETUP.md 创建 OIDC 应用、配置回调和托管登录方式。
# 不要添加 VITE_ / NEXT_PUBLIC_ 前缀，不要把密钥写入 public/。
JUZI_AUTH_ISSUER=
JUZI_AUTH_CLIENT_ID=

# 默认 none；必须与服务商的 token 端点认证方式一致。
# 可选：none | client_secret_post | client_secret_basic
JUZI_AUTH_TOKEN_AUTH_METHOD=none
JUZI_AUTH_CLIENT_SECRET=

# 无末尾斜线，必须与实际访问地址及回调域一致。
# 本地：http://localhost:5173 或 http://localhost:4174
# 生产：https://juzi-campus-market.open-bloom-6517.chatgpt.site
JUZI_AUTH_ORIGIN=

# 只有对应服务已在托管登录页开通并完成配置后，才改为 true。
# 两者默认关闭；填写 issuer/client ID 不会自动开放登录。
JUZI_AUTH_PHONE_ENABLED=false
JUZI_AUTH_WECHAT_ENABLED=false
