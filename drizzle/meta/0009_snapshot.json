        },
        "products_condition_valid": {
          "name": "products_condition_valid",
          "value": "(\"products\".\"category\" = 'service' AND \"products\".\"condition\" = '不适用') OR (\"products\".\"category\" <> 'service' AND \"products\".\"condition\" IN ('全新', '几乎全新', '轻微使用痕迹', '明显使用痕迹'))"
        }
