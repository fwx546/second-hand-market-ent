# Copy locally to relay/.env.local. Do not share or commit actual values.
# This example deliberately contains no usable email credential.
QQ_SMTP_USER=123456789@qq.com
QQ_SMTP_AUTH_CODE=

# Use the same >=32-character random value as JUZI_EMAIL_RELAY_TOKEN in root .env.local.
# Keep stable while retaining the ledger: it also derives the request-content HMAC key.
JUZI_RELAY_TOKEN=
QQ_RELAY_DAILY_LIMIT=50
# Default local mode ignores platform PORT and never binds publicly.
JUZI_RELAY_MODE=local
QQ_RELAY_HOST=127.0.0.1
QQ_RELAY_PORT=4180
# Optional. Relative paths resolve against relay/, regardless of the current directory.
QQ_RELAY_DB_PATH=.state/relay.sqlite
# Production must use cloud environment variables instead of copying this local file.
# See README.md and ../render.yaml: production mode requires a persistent disk and HTTPS origin.
